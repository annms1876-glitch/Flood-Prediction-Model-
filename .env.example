# ============================================================
# Flood Prediction Backend - Environment Example
# ============================================================
# 
# This file shows all available environment variables with
# placeholder values. Copy to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================================
# Get from: https://supabase.com/dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================================
# SECURITY CONFIGURATION
# ============================================================
# Generate JWT secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# API Key for server-to-server communication (optional)
API_KEY=your-api-key-change-in-production

# ============================================================
# CORS CONFIGURATION
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Origin,X-Requested-With,Content-Type,Accept,Authorization

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# ============================================================
# FIREBASE CONFIGURATION (OPTIONAL)
# ============================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIAL_PATH=./config/service-account.json

# ============================================================
# ALERT CONFIGURATION
# ============================================================
DEFAULT_ALERT_THRESHOLD=50
ALERT_CHANNELS=fcm

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_REQUESTS=true
LOG_MASK_FIELDS=password,token,authorization,api_key,secret,key

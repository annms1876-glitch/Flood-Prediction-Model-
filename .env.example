# ============================================================
# Flood Prediction Backend - Environment Example
# ============================================================
# 
# This file shows all available environment variables with
# placeholder values. Copy to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================
PORT=3000
NODE_ENV=development

# ============================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ============================================================
# Get from: https://supabase.com/dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ============================================================
# FIREBASE CONFIGURATION (OPTIONAL)
# ============================================================
# Get from: https://console.firebase.google.com/ > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIAL_PATH=./config/service-account.json

# ============================================================
# CORS CONFIGURATION
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================
# ALERT CONFIGURATION
# ============================================================
DEFAULT_ALERT_THRESHOLD=50
ALERT_CHANNELS=fcm

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=info

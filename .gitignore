# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
env/

# Environment files (NEVER commit these)
.env
.env.local
.env.*.local
*.env

# Security files (contain secrets)
config/service-account.json

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/
build/
*.egg-info/

# Testing
coverage/
htmlcov/
.coverage
.nyc_output/

# Temp files
tmp/
temp/

# ML Service - Pre-trained model weights (generated by setup_models.py)
ml-service/pretrained/*.pt
ml-service/pretrained/*.pkl
!ml-service/pretrained/model_config.json

# Firebase
.firebaserc
*.firebaseapp.com


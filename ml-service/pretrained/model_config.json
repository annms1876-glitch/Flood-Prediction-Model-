  "flat_cols": [
    "water_level_m",
    "rainfall_mm",
    "soil_moisture_percent",
    "tilt_degrees",
    "temperature_c",
    "humidity_percent",
    "water_level_delta",
    "rainfall_delta"
  ],
  "sensor_features": [
    "water_level_m",
    "rainfall_mm",
    "soil_moisture_percent",
    "tilt_degrees",
    "temperature_c",
    "humidity_percent"

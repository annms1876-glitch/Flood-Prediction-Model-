{
  "name": "flood-prediction-backend",
  "version": "1.0.0",
  "description": "Flood Prediction Backend API Service",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=lcov",
    "firebase:setup": "node scripts/setup-firebase.js",
    "firebase:check": "node scripts/setup-firebase.js --check"
  },
  "keywords": [
    "flood",
    "prediction",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase": "^10.13.1",
    "firebase-admin": "^12.7.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.4",
    "jsonwebtoken": "^9.0.2",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov"
    ]
  },
  "security": {
    "best_practices": [
      "Use strong JWT secrets (32+ characters)",
      "Enable rate limiting on all endpoints",
      "Validate and sanitize all user input",
      "Use HTTPS in production",
      "Set secure HTTP headers",
      "Implement CORS properly",
      "Never commit secrets to version control",
      "Rotate credentials regularly"
    ]
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
